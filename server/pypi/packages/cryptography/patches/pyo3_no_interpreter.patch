Pin an abi3 version floor on the pyo3 dependency. build-wheel compiles
without a Python interpreter (PYO3_NO_PYTHON=1), so pyo3 requires an explicit
abi3-py3* feature. See get_rust_env_vars in build-wheel.py.

--- a/Cargo.toml
+++ b/Cargo.toml
@@ -20,7 +20,7 @@
 
 [workspace.dependencies]
 asn1 = { version = "0.21.3", default-features = false }
-pyo3 = { version = "0.25", features = ["abi3"] }
+pyo3 = { version = "0.25", features = ["abi3", "abi3-py310"] }
 pyo3-build-config = { version = "0.25" }
 openssl = "0.10.72"
 openssl-sys = "0.9.108"
