Pin an abi3 version floor on the pyo3 dependency. build-wheel compiles
without a Python interpreter (PYO3_NO_PYTHON=1), so pyo3 requires an explicit
abi3-py3* feature. bcrypt's requires-python is >= 3.8.

--- a/src/_bcrypt/Cargo.toml
+++ b/src/_bcrypt/Cargo.toml
@@ -8,7 +8,7 @@
 publish = false

 [dependencies]
-pyo3 = { version = "0.26", features = ["abi3"] }
+pyo3 = { version = "0.26", features = ["abi3", "abi3-py38"] }
 bcrypt = "0.17"
 bcrypt-pbkdf = "0.10.0"
 base64 = "0.22.1"
